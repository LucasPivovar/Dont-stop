# Para uso local, o sistema funciona sem este arquivo.
PORT=3100
HOST=127.0.0.1
APP_ORIGIN=http://127.0.0.1:3100
# Para o primeiro cadastro remoto, defina um código longo e exclusivo.
GYM_SETUP_TOKEN=
# Opcional: caminho absoluto para o banco. O padrão é .data/gym.sqlite.
# GYM_DATABASE=/app/.data/gym.sqlite
# Links HTTPS dos parceiros, após a contratação dos benefícios.
# GYM_TELEMEDICINE_URL=https://parceiro.example.com/acesso
# GYM_DISCOUNTS_URL=https://clube.example.com/acesso
